{
  "tempDir": true,
  "tests": {
    "no_config": {
      // --no-config
      "args": "run -L debug -A --no-config noconfig.ts",
      "output": "noconfig.out",
      "cwd": "code"
    },
    "no_pkg_json_imports": {
      // this should not use --quiet because we should ensure no package.json install occurs
      "args": "run -A no_package_json_imports.ts",
      "output": "no_package_json_imports.out",
      "cwd": "code"
    }
  }
}
