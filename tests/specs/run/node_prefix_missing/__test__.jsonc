{
  "tests": {
    "basic": {
      "args": "run --quiet main.ts",
      "output": "feature_enabled.out"
    },
    "basic_no_config": {
      "args": "run --quiet --no-config main.ts",
      "output": "feature_enabled.out"
    },
    "unstable_bare_node_builtins_enabled2": {
      "args": "run main.ts",
      "envs": {
        "ENDE_COMPAT": "1"
      },
      "output": "feature_enabled.out"
    },
    "unstable_node_globals_enabled2": {
      "args": "run node_globals.ts",
      "envs": {
        "ENDE_COMPAT": "1"
      },
      "output": "node_globals.out"
    },
    "unstable_node_globals_enabled2_check": {
      "args": "check node_globals.ts",
      "envs": {
        "ENDE_COMPAT": "1"
      },
      "output": "node_globals_check.out"
    },
    "byonm_missing": {
      "cwd": "byonm",
      "args": "run missing.ts",
      "output": "byonm/has.out"
    },
    "byonm_has": {
      "cwd": "byonm",
      "args": "run has.ts",
      "output": "byonm/has.out"
    }
  }
}
