{
  "tests": {
    // ENDE_KV_ACCESS_TOKEN is read with permission for that name.
    "ende_name": {
      "envs": { "ENDE_KV_ACCESS_TOKEN": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" },
      "args": "run --unstable-kv --allow-net=localhost:4545 --allow-env=ENDE_KV_ACCESS_TOKEN main.ts",
      "output": "opened.out"
    },
    // The deprecated DENO_KV_ACCESS_TOKEN works when permission is granted
    // for that name, with a deprecation warning.
    "deno_name": {
      "envs": { "DENO_KV_ACCESS_TOKEN": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" },
      "args": "run --unstable-kv --allow-net=localhost:4545 --allow-env=DENO_KV_ACCESS_TOKEN main.ts",
      "output": "deno_name.out"
    },
    // Permission for ENDE_KV_ACCESS_TOKEN does not allow reading the
    // deprecated DENO_KV_ACCESS_TOKEN.
    "deno_name_without_permission": {
      "envs": { "DENO_KV_ACCESS_TOKEN": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" },
      "args": "run --unstable-kv --allow-net=localhost:4545 --allow-env=ENDE_KV_ACCESS_TOKEN main.ts",
      "output": "deno_name_without_permission.out",
      "exitCode": 1
    }
  }
}
