{
  "tempDir": true,
  "tests": {
    "basic_stdout": {
      "args": "transpile main.ts",
      "output": "basic_stdout.out"
    },
    "jsdoc_newline": {
      "args": "transpile jsdoc.ts",
      "output": "jsdoc.out"
    },
    "output_flag": {
      "steps": [
        {
          "args": "transpile main.ts -o out.js",
          "output": "[WILDCARD]ende transpile is experimental and subject to changes\nEmit [WILDCARD]out.js\n"
        },
        {
          "args": "run out.js",
          "output": "Hello, Alice! You are 30 years old.\n"
        }
      ]
    },
    "outdir": {
      "steps": [
        {
          "args": "transpile main.ts helpers.ts --outdir dist",
          "output": "outdir_emit.out"
        },
        {
          "args": "run dist/main.js",
          "output": "Hello, Alice! You are 30 years old.\n"
        }
      ]
    },
    "source_map_inline": {
      "args": "transpile main.ts --source-map inline",
      "output": "source_map_inline.out"
    },
    "source_map_separate": {
      "steps": [
        {
          "args": "transpile main.ts -o out.js --source-map separate",
          "output": "source_map_separate_emit.out"
        },
        {
          "args": "run --allow-read check_map.ts",
          "output": "3\nout.js\n"
        }
      ]
    },
    "declaration": {
      "steps": [
        {
          "args": "transpile main.ts -o out.js --declaration",
          "output": "declaration_emit.out"
        },
        {
          "args": "run --allow-read check_dts.ts",
          "output": "declaration_content.out"
        }
      ]
    },
    "error_output_multiple_files": {
      "args": "transpile main.ts helpers.ts -o out.js",
      "output": "[WILDCARD]ende transpile is experimental and subject to changes\nerror: Cannot use --output with multiple input files. Use --outdir instead.\n",
      "exitCode": 1
    },
    "error_output_and_outdir": {
      "args": "transpile main.ts -o out.js --outdir dist",
      "output": "[WILDCARD]the argument '--output <output>' cannot be used with '--outdir <outdir>'\n[WILDCARD]",
      "exitCode": 1
    },
    "error_declaration_no_output": {
      "args": "transpile main.ts --declaration",
      "output": "error_declaration_no_output.out",
      "exitCode": 1
    },
    "error_separate_sourcemap_stdout": {
      "args": "transpile main.ts --source-map separate",
      "output": "error_separate_sourcemap_stdout.out",
      "exitCode": 1
    },
    "skip_js_file": {
      "args": "transpile plain.js",
      "output": "skip_js_file.out",
      "exitCode": 1
    },
    "declaration_outdir": {
      "steps": [
        {
          "args": "transpile main.ts helpers.ts --outdir dist --declaration",
          "output": "declaration_outdir_emit.out"
        },
        {
          "args": "run --allow-read check_dts_outdir.ts",
          "output": "true\ntrue\n"
        }
      ]
    },
    "declaration_output_subdir": {
      "steps": [
        {
          "args": "transpile main.ts -o dist/out.js --declaration",
          "output": "declaration_output_subdir_emit.out"
        },
        {
          "args": "run --allow-read check_dts_subdir.ts",
          "output": "true\n"
        }
      ]
    },
    "tsx_file": {
      "args": "transpile component.tsx",
      "output": "tsx.out"
    },
    "mts_outdir": {
      "steps": [
        {
          "args": "transpile helper.mts --outdir dist",
          "output": "[WILDCARD]ende transpile is experimental and subject to changes\nEmit [WILDCARD]dist[WILDCARD]helper.mjs\n"
        },
        {
          "args": "run dist/helper.mjs",
          "output": ""
        }
      ]
    },
    "cts_outdir": {
      "steps": [
        {
          "args": "transpile helper.cts --outdir dist",
          "output": "[WILDCARD]ende transpile is experimental and subject to changes\nEmit [WILDCARD]dist[WILDCARD]helper.cjs\n"
        },
        {
          "args": "run --allow-read check_cts_outdir.ts",
          "output": "true\n"
        }
      ]
    },
    "cts_source_map_separate": {
      "steps": [
        {
          "args": "transpile helper.cts -o out.cjs --source-map separate",
          "output": "[WILDCARD]ende transpile is experimental and subject to changes\nEmit [WILDCARD]out.cjs\nEmit [WILDCARD]out.cjs.map\n"
        },
        {
          "args": "run --allow-read check_cts_map.ts",
          "output": "3\nout.cjs\n"
        }
      ]
    },
    "mts_source_map_separate": {
      "steps": [
        {
          "args": "transpile helper.mts -o out.mjs --source-map separate",
          "output": "[WILDCARD]ende transpile is experimental and subject to changes\nEmit [WILDCARD]out.mjs\nEmit [WILDCARD]out.mjs.map\n"
        },
        {
          "args": "run --allow-read check_mts_map.ts",
          "output": "3\nout.mjs\n"
        }
      ]
    },
    "rewrite_specifiers": {
      "args": "transpile rewrite/specifiers.ts",
      "output": "rewrite_specifiers.out"
    },
    "rewrite_require_cts": {
      "args": "transpile rewrite/require.cts",
      "output": "rewrite_require.out"
    },
    "rewrite_project": {
      "steps": [
        {
          "args": "transpile rewrite/app/main.ts rewrite/app/util.ts rewrite/app/types.ts rewrite/app/dynamic.ts --outdir dist",
          "output": "rewrite_project_emit.out"
        },
        {
          "args": "run dist/main.js",
          "output": "3\n42\n"
        },
        {
          "args": "run rewrite/check_reexport.js",
          "output": "3\n42\n{ x: 0, y: 0 }\n"
        }
      ]
    },
    "rewrite_declarations": {
      "steps": [
        {
          "args": "transpile rewrite/decl/main.ts rewrite/decl/lib/types.ts rewrite/decl/lib/consts.mts rewrite/decl/lib/util.tsx rewrite/decl/lib/legacy.cts --outdir dist --declaration",
          "output": "[WILDCARD]Emit [WILDCARD]main.d.ts\n"
        },
        {
          "args": "run --allow-read rewrite/print_declarations.ts",
          "output": "rewrite_declarations.out"
        }
      ]
    },
    "rewrite_source_map": {
      "steps": [
        {
          "args": "transpile rewrite/sourcemap.ts -o out.js --source-map separate",
          "output": "source_map_separate_emit.out"
        },
        {
          "args": "run --allow-read rewrite/check_sourcemap.ts",
          "output": "import(\"./dynamic.js\").then((m)=>console.log(add(m.value, 1)));\ntrue\ntrue\n"
        }
      ]
    },
    "skip_declaration_arguments": {
      "steps": [
        {
          "args": "transpile declaration_inputs/main.ts declaration_inputs/types.d.ts declaration_inputs/consts.d.mts declaration_inputs/legacy.d.cts declaration_inputs/styles.d.css.ts --outdir dist",
          "output": "skip_declaration_arguments.out"
        },
        {
          "args": "run --allow-read declaration_inputs/list_dist.ts",
          "output": "dist/main.js\n"
        },
        {
          "args": "run dist/main.js",
          "output": "{ x: 0, y: 0 }\n"
        }
      ]
    },
    "skip_declaration_output_flag": {
      "steps": [
        {
          "args": "transpile declaration_inputs/main.ts declaration_inputs/types.d.ts -o out.js",
          "output": "[WILDCARD]ende transpile is experimental and subject to changes\nSkip [WILDLINE]types.d.ts (declaration file)\nEmit [WILDLINE]out.js\n"
        },
        {
          "args": "run out.js",
          "output": "{ x: 0, y: 0 }\n"
        }
      ]
    },
    "skip_declaration_stdout": {
      "args": "transpile declaration_inputs/types.d.ts declaration_inputs/main.ts",
      "output": "skip_declaration_stdout.out"
    },
    "skip_declaration_only": {
      "args": "transpile declaration_inputs/types.d.ts declaration_inputs/globals.d.ts",
      "output": "skip_declaration_only.out",
      "exitCode": 1
    },
    "skip_declaration_type_check": {
      "steps": [
        {
          "args": "transpile declaration_inputs/main.ts declaration_inputs/version.ts declaration_inputs/globals.d.ts --outdir dist --declaration",
          "output": "skip_declaration_type_check.out"
        },
        {
          "args": "run --allow-read declaration_inputs/list_dist.ts",
          "output": "dist/main.d.ts\ndist/main.js\ndist/version.d.ts\ndist/version.js\n"
        }
      ]
    },
    // With --outdir, outputs mirror the inputs' layout below their common
    // parent directory, so inputs can live outside the cwd.
    "common_root_outdir": {
      "steps": [
        {
          "cwd": "common_root/work",
          "args": "transpile ../src/main.ts ../src/config.ts ../src/lib/greet.ts ../ambient.d.ts --outdir dist",
          "output": "common_root_outdir.out"
        },
        {
          "cwd": "common_root/work",
          "args": "run --allow-read ../../declaration_inputs/list_dist.ts",
          "output": "dist/config.js\ndist/lib/greet.js\ndist/main.js\n"
        },
        {
          "cwd": "common_root/work",
          "args": "run dist/main.js",
          "output": "Hello, Ende!\n"
        }
      ]
    },
    "common_root_canonical_paths": {
      "steps": [
        {
          "cwd": "common_root/work",
          "args": "transpile ../src/lib/../main.ts ../work/../src/config.ts ../src/lib/greet.ts --outdir dist",
          "output": "[WILDCARD]greet.js\n"
        },
        {
          "cwd": "common_root/work",
          "args": "run --allow-read ../../declaration_inputs/list_dist.ts",
          "output": "dist/config.js\ndist/lib/greet.js\ndist/main.js\n"
        },
        {
          "cwd": "common_root/work",
          "args": "run dist/main.js",
          "output": "Hello, Ende!\n"
        }
      ]
    },
    "common_root_single_input": {
      "steps": [
        {
          "cwd": "common_root/work",
          "args": "transpile ../src/lib/greet.ts --outdir dist",
          "output": "[WILDCARD]ende transpile is experimental and subject to changes\nEmit [WILDLINE]greet.js\n"
        },
        {
          "cwd": "common_root/work",
          "args": "run --allow-read ../../declaration_inputs/list_dist.ts",
          "output": "dist/greet.js\n"
        }
      ]
    },
    "common_root_output_flag": {
      "steps": [
        {
          "cwd": "common_root/work",
          "args": "transpile ../hello.ts -o out.js",
          "output": "[WILDCARD]ende transpile is experimental and subject to changes\nEmit [WILDLINE]out.js\n"
        },
        {
          "cwd": "common_root/work",
          "args": "run out.js",
          "output": "Hello from outside the cwd\n"
        },
        {
          "cwd": "common_root/work",
          "args": "transpile ../hello.ts",
          "output": "[WILDCARD]const where = \"outside the cwd\";\nconsole.log(`Hello from ${where}`);\n"
        }
      ]
    },
    "common_root_declaration": {
      "steps": [
        {
          "cwd": "common_root/work",
          "args": "transpile ../src/main.ts ../src/config.ts ../src/lib/greet.ts --outdir dist --declaration",
          "output": "[WILDCARD]main.d.ts\n"
        },
        {
          "cwd": "common_root/work",
          "args": "run --allow-read ../../declaration_inputs/list_dist.ts",
          "output": "dist/config.d.ts\ndist/config.js\ndist/lib/greet.d.ts\ndist/lib/greet.js\ndist/main.d.ts\ndist/main.js\n"
        },
        {
          "cwd": "common_root/work",
          "args": "run --allow-read print_declarations.ts",
          "output": "common_root_declarations.out"
        }
      ]
    },
    // tsc also emits declarations for imported local files, which have to
    // fit under the inputs' common parent directory too.
    "common_root_declaration_outside_root": {
      "cwd": "common_root/work",
      "args": "transpile ../src/lib/greet.ts --outdir dist --declaration",
      "output": "common_root_declaration_outside_root.out",
      "exitCode": 1
    },
    "common_root_source_map": {
      "steps": [
        {
          "cwd": "common_root/work",
          "args": "transpile ../src/main.ts ../src/config.ts ../src/lib/greet.ts --outdir dist --source-map separate",
          "output": "[WILDCARD]greet.js.map\n"
        },
        {
          "cwd": "common_root/work",
          "args": "run --allow-read check_maps.ts",
          "output": "main.js true\ngreet.js true\n"
        },
        {
          "cwd": "common_root/work",
          "args": "run dist/main.js",
          "output": "Hello, Ende!\n"
        }
      ]
    },
    // --check type-checks before anything is written, so a failed check
    // leaves no output behind.
    "check_type_error": {
      "steps": [
        {
          "args": "transpile --check check/bad.ts --outdir dist",
          "output": "check_type_error.out",
          "exitCode": 1
        },
        {
          "args": "run --allow-read check/list_dist.ts",
          "output": "no dist\n"
        },
        {
          "args": "transpile --check check/bad.ts",
          "output": "check_type_error.out",
          "exitCode": 1
        }
      ]
    },
    "check_ok": {
      "steps": [
        {
          "args": "transpile --check check/good.ts --outdir dist",
          "output": "[WILDCARD]ende transpile is experimental and subject to changes\nCheck [WILDLINE]good.ts\nEmit [WILDLINE]good.js\n"
        },
        {
          "args": "run dist/good.js",
          "output": "1\n"
        }
      ]
    },
    "check_off_by_default": {
      "steps": [
        {
          "args": "transpile check/bad.ts --outdir dist",
          "output": "[WILDCARD]ende transpile is experimental and subject to changes\nEmit [WILDLINE]bad.js\n"
        },
        {
          "args": "run --allow-read check/list_dist.ts",
          "output": "dist/bad.js\n"
        }
      ]
    },
    // --declaration type-checks too, also before anything is written.
    "declaration_type_error": {
      "steps": [
        {
          "args": "transpile --declaration check/bad.ts --outdir dist",
          "output": "declaration_type_error.out",
          "exitCode": 1
        },
        {
          "args": "run --allow-read check/list_dist.ts",
          "output": "no dist\n"
        },
        // The declaration pass is the type check, so the error is reported
        // once.
        {
          "args": "transpile --check --declaration check/bad.ts --outdir dist",
          "output": "declaration_type_error.out",
          "exitCode": 1
        },
        {
          "args": "run --allow-read check/list_dist.ts",
          "output": "no dist\n"
        }
      ]
    },
    "declaration_no_check": {
      "steps": [
        {
          "args": "transpile --declaration --no-check check/bad.ts --outdir dist",
          "output": "[WILDCARD]ende transpile is experimental and subject to changes\nEmit [WILDLINE]bad.js\nEmit [WILDLINE]bad.d.ts\n"
        },
        {
          "args": "run --allow-read check/list_dist.ts",
          "output": "dist/bad.d.ts\ndist/bad.js\n"
        }
      ]
    },
    // Like `ende check`, diagnostics from remote modules are only reported
    // with --check=all.
    "check_remote": {
      "steps": [
        {
          "args": "transpile --check=all check/remote.ts --outdir dist",
          "output": "check_remote_all.out",
          "exitCode": 1
        },
        {
          "args": "run --allow-read check/list_dist.ts",
          "output": "no dist\n"
        },
        {
          "args": "transpile --check check/remote.ts --outdir dist",
          "output": "[WILDCARD]Check [WILDLINE]remote.ts\nEmit [WILDLINE]remote.js\n"
        }
      ]
    },
    // As with `ende run`, --no-check=remote still checks local modules.
    "no_check_remote": {
      "steps": [
        {
          "args": "transpile --no-check=remote check/remote.ts --outdir dist",
          "output": "[WILDCARD]Emit [WILDLINE]remote.js\n"
        },
        {
          "args": "transpile --no-check=remote check/bad.ts --outdir dist",
          "output": "check_type_error.out",
          "exitCode": 1
        }
      ]
    },
    "declaration_check_all_remote": {
      "steps": [
        {
          "args": "transpile --declaration --check=all check/remote.ts --outdir dist",
          "output": "declaration_remote_all.out",
          "exitCode": 1
        },
        {
          "args": "run --allow-read check/list_dist.ts",
          "output": "no dist\n"
        }
      ]
    },
    "config_flag_missing": {
      "args": "transpile --config missing.json compile_args/component.tsx",
      "output": "config_flag_missing.out",
      "exitCode": 1
    },
    // The compilerOptions of the --config file apply to the emit, also for
    // inputs outside the config's directory.
    "config_flag_jsx": {
      "args": "transpile --config compile_args/cfg/ende.json compile_args/component.tsx",
      "output": "config_jsx.out"
    },
    "no_config": {
      "steps": [
        {
          "cwd": "compile_args/discovered",
          "args": "transpile component.tsx",
          "output": "config_jsx.out"
        },
        {
          "cwd": "compile_args/discovered",
          "args": "transpile --no-config component.tsx",
          "output": "no_config_jsx.out"
        }
      ]
    },
    "import_map_flag": {
      "steps": [
        {
          "args": "transpile --check compile_args/import_map/main.ts --outdir dist",
          "output": "[WILDCARD]Import \"greet\" not a dependency[WILDCARD]",
          "exitCode": 1
        },
        {
          "args": "transpile --check --import-map compile_args/import_map/map.json compile_args/import_map/main.ts --outdir dist",
          "output": "[WILDCARD]ende transpile is experimental and subject to changes\nCheck [WILDLINE]main.ts\nEmit [WILDLINE]main.js\n"
        }
      ]
    },
    // The cutoff sits between 0.2.0 (2025-01-20) and 0.2.1 (2025-05-20), so
    // 0.2.0 is type-checked instead of the newest 1.0.0, which has no sum().
    "minimum_dependency_age_flag": {
      "args": "transpile --check --minimum-dependency-age=2025-05-01T20:00:00.000Z compile_args/min_dep_age/main.ts --outdir dist",
      "output": "minimum_dependency_age.out"
    }
  }
}
