{
  "tempDir": true,
  "tests": {
    "basic_stdout": {
      "args": "transpile main.ts",
      "output": "basic_stdout.out"
    },
    "jsdoc_newline": {
      "args": "transpile jsdoc.ts",
      "output": "jsdoc.out"
    },
    "output_flag": {
      "steps": [
        {
          "args": "transpile main.ts -o out.js",
          "output": "[WILDCARD]ende transpile is experimental and subject to changes\nEmit [WILDCARD]out.js\n"
        },
        {
          "args": "run out.js",
          "output": "Hello, Alice! You are 30 years old.\n"
        }
      ]
    },
    "outdir": {
      "steps": [
        {
          "args": "transpile main.ts helpers.ts --outdir dist",
          "output": "outdir_emit.out"
        },
        {
          "args": "run dist/main.js",
          "output": "Hello, Alice! You are 30 years old.\n"
        }
      ]
    },
    "source_map_inline": {
      "args": "transpile main.ts --source-map inline",
      "output": "source_map_inline.out"
    },
    "source_map_separate": {
      "steps": [
        {
          "args": "transpile main.ts -o out.js --source-map separate",
          "output": "source_map_separate_emit.out"
        },
        {
          "args": "run --allow-read check_map.ts",
          "output": "3\nout.js\n"
        }
      ]
    },
    "declaration": {
      "steps": [
        {
          "args": "transpile main.ts -o out.js --declaration",
          "output": "declaration_emit.out"
        },
        {
          "args": "run --allow-read check_dts.ts",
          "output": "declaration_content.out"
        }
      ]
    },
    "error_output_multiple_files": {
      "args": "transpile main.ts helpers.ts -o out.js",
      "output": "[WILDCARD]ende transpile is experimental and subject to changes\nerror: Cannot use --output with multiple input files. Use --outdir instead.\n",
      "exitCode": 1
    },
    "error_output_and_outdir": {
      "args": "transpile main.ts -o out.js --outdir dist",
      "output": "[WILDCARD]the argument '--output <output>' cannot be used with '--outdir <outdir>'\n[WILDCARD]",
      "exitCode": 1
    },
    "error_declaration_no_output": {
      "args": "transpile main.ts --declaration",
      "output": "error_declaration_no_output.out",
      "exitCode": 1
    },
    "error_separate_sourcemap_stdout": {
      "args": "transpile main.ts --source-map separate",
      "output": "error_separate_sourcemap_stdout.out",
      "exitCode": 1
    },
    "skip_js_file": {
      "args": "transpile plain.js",
      "output": "skip_js_file.out",
      "exitCode": 1
    },
    "declaration_outdir": {
      "steps": [
        {
          "args": "transpile main.ts helpers.ts --outdir dist --declaration",
          "output": "declaration_outdir_emit.out"
        },
        {
          "args": "run --allow-read check_dts_outdir.ts",
          "output": "true\ntrue\n"
        }
      ]
    },
    "declaration_output_subdir": {
      "steps": [
        {
          "args": "transpile main.ts -o dist/out.js --declaration",
          "output": "declaration_output_subdir_emit.out"
        },
        {
          "args": "run --allow-read check_dts_subdir.ts",
          "output": "true\n"
        }
      ]
    },
    "tsx_file": {
      "args": "transpile component.tsx",
      "output": "tsx.out"
    },
    "mts_outdir": {
      "steps": [
        {
          "args": "transpile helper.mts --outdir dist",
          "output": "[WILDCARD]ende transpile is experimental and subject to changes\nEmit [WILDCARD]dist[WILDCARD]helper.mjs\n"
        },
        {
          "args": "run dist/helper.mjs",
          "output": ""
        }
      ]
    },
    "cts_outdir": {
      "steps": [
        {
          "args": "transpile helper.cts --outdir dist",
          "output": "[WILDCARD]ende transpile is experimental and subject to changes\nEmit [WILDCARD]dist[WILDCARD]helper.cjs\n"
        },
        {
          "args": "run --allow-read check_cts_outdir.ts",
          "output": "true\n"
        }
      ]
    },
    "cts_source_map_separate": {
      "steps": [
        {
          "args": "transpile helper.cts -o out.cjs --source-map separate",
          "output": "[WILDCARD]ende transpile is experimental and subject to changes\nEmit [WILDCARD]out.cjs\nEmit [WILDCARD]out.cjs.map\n"
        },
        {
          "args": "run --allow-read check_cts_map.ts",
          "output": "3\nout.cjs\n"
        }
      ]
    },
    "mts_source_map_separate": {
      "steps": [
        {
          "args": "transpile helper.mts -o out.mjs --source-map separate",
          "output": "[WILDCARD]ende transpile is experimental and subject to changes\nEmit [WILDCARD]out.mjs\nEmit [WILDCARD]out.mjs.map\n"
        },
        {
          "args": "run --allow-read check_mts_map.ts",
          "output": "3\nout.mjs\n"
        }
      ]
    },
    "rewrite_specifiers": {
      "args": "transpile rewrite/specifiers.ts",
      "output": "rewrite_specifiers.out"
    },
    "rewrite_require_cts": {
      "args": "transpile rewrite/require.cts",
      "output": "rewrite_require.out"
    },
    "rewrite_project": {
      "steps": [
        {
          "args": "transpile rewrite/app/main.ts rewrite/app/util.ts rewrite/app/types.ts rewrite/app/dynamic.ts --outdir dist",
          "output": "rewrite_project_emit.out"
        },
        {
          "args": "run dist/rewrite/app/main.js",
          "output": "3\n42\n"
        },
        {
          "args": "run rewrite/check_reexport.js",
          "output": "3\n42\n{ x: 0, y: 0 }\n"
        }
      ]
    },
    "rewrite_declarations": {
      "steps": [
        {
          "args": "transpile rewrite/decl/main.ts rewrite/decl/lib/types.ts rewrite/decl/lib/consts.mts rewrite/decl/lib/util.tsx rewrite/decl/lib/legacy.cts --outdir dist --declaration",
          "output": "[WILDCARD]Emit [WILDCARD]main.d.ts\n"
        },
        {
          "args": "run --allow-read rewrite/print_declarations.ts",
          "output": "rewrite_declarations.out"
        }
      ]
    },
    "rewrite_source_map": {
      "steps": [
        {
          "args": "transpile rewrite/sourcemap.ts -o out.js --source-map separate",
          "output": "source_map_separate_emit.out"
        },
        {
          "args": "run --allow-read rewrite/check_sourcemap.ts",
          "output": "import(\"./dynamic.js\").then((m)=>console.log(add(m.value, 1)));\ntrue\ntrue\n"
        }
      ]
    },
    "skip_declaration_arguments": {
      "steps": [
        {
          "args": "transpile declaration_inputs/main.ts declaration_inputs/types.d.ts declaration_inputs/consts.d.mts declaration_inputs/legacy.d.cts declaration_inputs/styles.d.css.ts --outdir dist",
          "output": "skip_declaration_arguments.out"
        },
        {
          "args": "run --allow-read declaration_inputs/list_dist.ts",
          "output": "dist/declaration_inputs/main.js\n"
        },
        {
          "args": "run dist/declaration_inputs/main.js",
          "output": "{ x: 0, y: 0 }\n"
        }
      ]
    },
    "skip_declaration_output_flag": {
      "steps": [
        {
          "args": "transpile declaration_inputs/main.ts declaration_inputs/types.d.ts -o out.js",
          "output": "[WILDCARD]ende transpile is experimental and subject to changes\nSkip [WILDLINE]types.d.ts (declaration file)\nEmit [WILDLINE]out.js\n"
        },
        {
          "args": "run out.js",
          "output": "{ x: 0, y: 0 }\n"
        }
      ]
    },
    "skip_declaration_stdout": {
      "args": "transpile declaration_inputs/types.d.ts declaration_inputs/main.ts",
      "output": "skip_declaration_stdout.out"
    },
    "skip_declaration_only": {
      "args": "transpile declaration_inputs/types.d.ts declaration_inputs/globals.d.ts",
      "output": "skip_declaration_only.out",
      "exitCode": 1
    },
    "skip_declaration_type_check": {
      "steps": [
        {
          "args": "transpile declaration_inputs/main.ts declaration_inputs/version.ts declaration_inputs/globals.d.ts --outdir dist --declaration",
          "output": "skip_declaration_type_check.out"
        },
        {
          "args": "run --allow-read declaration_inputs/list_dist.ts",
          "output": "dist/declaration_inputs/main.d.ts\ndist/declaration_inputs/main.js\ndist/declaration_inputs/version.d.ts\ndist/declaration_inputs/version.js\n"
        }
      ]
    }
  }
}
