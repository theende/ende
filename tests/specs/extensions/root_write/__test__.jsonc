{
  "tempDir": true,
  "tests": {
    // An extension granted write on ./output writes inside a root the host
    // hands it, and every way out through that root fails: `..` and
    // absolute paths throw PathEscape, and a symlink out is already denied
    // by its own permissions, which match real paths on an extension's
    // thread; a plain write outside is denied too.
    "writes_inside_cannot_escape": {
      "steps": [
        {
          "args": "run --quiet --allow-read --allow-write setup.ts",
          "output": ""
        },
        {
          "args": "run --quiet --unstable-fs --allow-read --allow-write=output main.ts",
          "output": "main.out"
        }
      ]
    }
  }
}
