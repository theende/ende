{
  "tempDir": true,
  "tests": {
    "check": {
      "args": "check main.ts",
      "output": "check.out",
      "exitCode": 1
    },
    "info": {
      "args": ["info", "#add"],
      "output": "info.out"
    },
    "run": {
      "args": "run main.ts",
      "output": "run.out"
    },
    "compile": {
      "steps": [{
        "args": "compile --no-check --output bin main.ts",
        "output": "[WILDCARD]"
      }, {
        "commandName": "./bin",
        "args": [],
        "output": "run.out"
      }]
    }
  }
}
