{
  "tempDir": true,
  "tests": {
    "node_modules_dir_manual": {
      "steps": [{
        "args": "run -RW backup_cowsay.ts",
        "output": ""
      }, {
        "args": "install",
        "output": "[WILDCARD]",
        "cwd": "main"
      }, {
        "args": "run main/main.ts",
        "output": "3\n"
      }, {
        "args": [
          "eval",
          "console.log(Deno.readTextFileSync('./main/ende.lock').trim())"
        ],
        "output": "expected_lockfile.out"
      }, {
        "args": "run -R verify_cowsay.ts",
        "output": "true\ntrue\n"
      }, {
        "args": "run -RW change_patch.ts",
        "output": ""
      }, {
        "args": "run -RW backup_cowsay.ts",
        "output": ""
      }, {
        "args": "install",
        "output": "[WILDCARD]",
        "cwd": "main"
      }, {
        "args": [
          "eval",
          "console.log(Deno.readTextFileSync('./main/ende.lock').trim())"
        ],
        "output": "expected_lockfile_after_change.out"
      }, {
        "args": "run main/main.ts",
        "output": "3\n"
      }, {
        "args": "run -R verify_cowsay.ts",
        "output": "true\ntrue\n"
      }]
    }
  }
}
