{
  "tempDir": true,
  "tests": {
    "set_for_npm_package": {
      "steps": [
        {
          "args": "install",
          "output": "[WILDCARD]"
        },
        {
          "args": "run -A npm:@denotest/print-npm-user-agent",
          "output": "run.out"
        }
      ]
    },
    "set_for_tasks": {
      "steps": [
        {
          "args": "install",
          "output": "[WILDCARD]"
        },
        {
          "args": "task run-via-bin",
          "output": "bin_command.out"
        }
      ]
    }
  }
}
