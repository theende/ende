{
  "tests": {
    "cjs_with_deps": {
      "tempDir": true,
      "args": "run --allow-read --allow-env main.js",
      "output": "main.out"
    },
    "cjs_with_deps_info": {
      "steps": [
        {
          "args": "cache main.js",
          "output": "[WILDCARD]"
        },
        {
          "args": "info main.js",
          "output": "main_info.out"
        }
      ]
    },
    "cjs_with_deps_info_json": {
      "steps": [
        {
          "args": "cache main.js",
          "output": "[WILDCARD]"
        },
        {
          "args": "info --json main.js",
          "output": "main_info_json.out"
        }
      ]
    }
  }
}
