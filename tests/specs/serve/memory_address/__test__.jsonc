{
  "tests": {
    // ENDE_SERVE_ADDRESS=memory:<host> names a listener that only the desktop
    // runtime in the same process connects to, so only the desktop runtime
    // may set it (in its process-local environment, see
    // `ende_os::set_process_local_env_var`). From the process environment it
    // is refused, and the server listens where it asked.
    "rejected_from_environment": {
      "args": "run --allow-net=127.0.0.1 tcp_listen.ts",
      "envs": { "ENDE_SERVE_ADDRESS": "memory:app.example" },
      "output": "rejected.out",
      "exitCode": 0
    },
    "rejected_duplicate_from_environment": {
      "args": "run --allow-net=127.0.0.1 tcp_listen.ts",
      "envs": { "ENDE_SERVE_ADDRESS": "duplicate,memory:app.example" },
      "output": "rejected.out",
      "exitCode": 0
    },
    "rejected_deprecated_name_from_environment": {
      "args": "run --allow-net=127.0.0.1 tcp_listen.ts",
      "envs": { "DENO_SERVE_ADDRESS": "memory:app.example" },
      "output": "rejected_deprecated_name.out",
      "exitCode": 0
    }
  }
}
