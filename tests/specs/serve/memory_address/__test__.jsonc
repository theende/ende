{
  "tests": {
    // ENDE_SERVE_ADDRESS=memory:<host> (what the desktop runtime sets) puts
    // Ende.serve on the in-process memory transport in any `ende run`: a
    // listener only this process's own Rust side can connect to, so it needs
    // no net permission and opens no socket.
    "listens_in_process": {
      "args": "run listen.ts",
      "envs": { "ENDE_SERVE_ADDRESS": "memory:spec-mem.example" },
      "output": "listen.out",
      "exitCode": 0
    },
    "default_log": {
      "args": "run default_log.ts",
      "envs": { "ENDE_SERVE_ADDRESS": "memory:spec-log.example" },
      "output": "default_log.out",
      "exitCode": 0
    },
    // The name is the host of `request.url`, so it must be a lowercase domain
    // name. Anything else is refused and the server listens where it asked.
    "invalid_host": {
      "args": "run --allow-net=127.0.0.1 invalid_host.ts",
      "envs": { "ENDE_SERVE_ADDRESS": "memory:Spec.Example:80" },
      "output": "invalid_host.out",
      "exitCode": 0
    }
  }
}
