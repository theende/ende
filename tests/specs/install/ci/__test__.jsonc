{
  "tempDir": true,
  "tests": {
    "no_lockfile": {
      "args": "ci",
      "output": "no_lockfile.out",
      "exitCode": 1
    },
    "stale_lockfile_errors": {
      "steps": [{
        "args": [
          "eval",
          "Deno.writeTextFileSync('ende.json', JSON.stringify({ imports: { 'add': 'jsr:@endetest/add@1' } }))"
        ],
        "output": ""
      }, {
        "args": "install",
        "output": "[WILDCARD]"
      }, {
        "args": [
          "eval",
          "Deno.writeTextFileSync('ende.json', JSON.stringify({ imports: { 'add': 'jsr:@endetest/add@1', 'subtract': 'jsr:@endetest/subtract@1' } }))"
        ],
        "output": ""
      }, {
        "args": "ci",
        "output": "stale_lockfile.out",
        "exitCode": 1
      }]
    }
  }
}
