{
  "tempDir": true,
  "steps": [
    {
      "args": "install jsr:@endetest/add",
      "output": "install.out"
    },
    {
      // make sure the dep got cached
      "args": "run --cached-only main.js",
      "output": ""
    },
    {
      "args": [
        "eval",
        "console.log(Deno.readTextFileSync('ende.json').trim())"
      ],
      "output": "ende.json.out"
    }
  ]
}
