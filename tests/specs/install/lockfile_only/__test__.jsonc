{
  "tempDir": true,
  "steps": [
    {
      "args": "install --lockfile-only jsr:@endetest/add",
      "output": "install.out"
    },
    {
      // Verify the lockfile was created and contains the package
      "args": [
        "eval",
        "const lock = JSON.parse(Deno.readTextFileSync('ende.lock')); console.log(Object.keys(lock.jsr).includes('@endetest/add@1.0.0'))"
      ],
      "output": "true\n"
    },
    {
      // Now run install without --lockfile-only to cache the package
      "args": "install",
      "output": "[WILDCARD]"
    },
    {
      // Verify the package was cached this time
      "args": "run --cached-only main.ts",
      "output": "3\n"
    }
  ]
}
