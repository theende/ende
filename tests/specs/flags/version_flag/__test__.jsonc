{
  "tests": {
    "uppercase_v": {
      "args": "-V",
      "output": "ende [WILDLINE]\n"
    },
    "lowercase_v": {
      "args": "-v",
      "output": "ende [WILDLINE]\n"
    },
    "long_version": {
      "args": "--version",
      "output": "ende [WILDLINE] ([WILDLINE])\nv8 [WILDLINE]\ntypescript [WILDLINE]\n"
    }
  }
}
