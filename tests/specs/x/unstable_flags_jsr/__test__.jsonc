{
  "tempDir": true,
  "tests": {
    "with_flag": {
      "if": "notSlowCiShard",
      "args": "x -y --unstable-kv jsr:@endetest/x-unstable-kv",
      "output": "with_flag.out"
    },
    "without_flag": {
      "if": "notSlowCiShard",
      "args": "x -y jsr:@endetest/x-unstable-kv",
      "exitCode": 1,
      "output": "without_flag.out"
    }
  }
}
