{
  "tempDir": true,
  "tests": {
    // `isolate` rules don't sandbox anything yet, so commands that run the
    // app's code say so, once, instead of letting the rules look enforced.
    "run": {
      "args": "run main.ts",
      "output": "Warning \"isolate\" rules are not enforced yet: sandboxed dependencies still run with the app's permissions.\nhello\n"
    },
    "test": {
      "args": "test main_test.ts",
      "output": "Warning \"isolate\" rules are not enforced yet: sandboxed dependencies still run with the app's permissions.\n[WILDCARD]ok | 1 passed[WILDCARD]"
    },
    "quiet": {
      "args": "run --quiet main.ts",
      "output": "hello\n"
    },
    // No rules, no warning.
    "no_rules": {
      "args": "run --config empty.json main.ts",
      "output": "hello\n"
    }
  }
}
