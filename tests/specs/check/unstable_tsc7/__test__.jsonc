// Copyright 2026 the Ende authors. MIT license.
// `--unstable-tsc7` (or `"unstable": ["tsc7"]`) selects the bundled
// TypeScript 7 compiler for type checking, or the one `ENDE_TSC_BIN` points
// at. Test builds bundle none, so type checking refuses it unless
// `ENDE_TSC_BIN` is set (tsc7/ has the specs that run one). Subcommands
// that don't type-check ignore it.
{
  "tests": {
    "check_flag": {
      "args": "check --unstable-tsc7 main.ts",
      "output": "unavailable.out",
      "exitCode": 1
    },
    "check_config": {
      "cwd": "config",
      "args": "check main.ts",
      "output": "unavailable.out",
      "exitCode": 1
    },
    "env_bin_missing": {
      "args": "check --unstable-tsc7 main.ts",
      "envs": { "ENDE_TSC_BIN": "/nonexistent" },
      "output": "env_bin_missing.out",
      "exitCode": 1
    },
    // A relative ENDE_TSC_BIN is resolved against the working directory.
    // `main.ts` isn't executable, so running it fails.
    "env_bin": {
      "args": "check --unstable-tsc7 main.ts",
      "envs": { "ENDE_TSC_BIN": "main.ts" },
      "output": "env_bin.out",
      "exitCode": 1
    },
    "run_ignores_flag": {
      "args": "run --unstable-tsc7 main.ts",
      "output": "run.out"
    },
    "run_check": {
      "args": "run --check --unstable-tsc7 main.ts",
      "output": "unavailable.out",
      "exitCode": 1
    }
  }
}
