{
  "tests": {
    "check": {
      "args": "check --doc-only markdown.md",
      "exitCode": 1,
      "output": "markdown.out"
    },
    "check_tsc7": {
      "if": "tsc7",
      "args": "check --unstable-tsc7 --doc-only markdown.md",
      "exitCode": 1,
      "output": "markdown.out"
    }
  }
}
