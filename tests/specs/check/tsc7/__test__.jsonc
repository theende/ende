// Copyright 2026 the Ende authors. MIT license.
// `ende check --unstable-tsc7` type-checks with TypeScript 7's `tsc`. Test
// builds bundle none, so these run only when ENDE_TEST_TSC7_BIN points at one
// (the harness passes it on as ENDE_TSC_BIN), and are skipped otherwise.
{
  "if": "tsc7",
  "tests": {
    "local_error": {
      "args": "check --unstable-tsc7 local_error/main.ts",
      "output": "local_error.out",
      "exitCode": 1
    },
    // `"unstable": ["tsc7"]` in the config selects it too.
    "config": {
      "cwd": "config",
      "args": "check main.ts",
      "output": "config.out",
      "exitCode": 1
    },
    "clean": {
      "args": "check --unstable-tsc7 clean/main.ts",
      "output": "Check clean/main.ts\n"
    },
    // The Ende libs are there, typed.
    "globals": {
      "args": "check --unstable-tsc7 globals/main.ts",
      "output": "globals.out",
      "exitCode": 1
    },
    // Remote modules are mirrored into the cache; their diagnostics count
    // only with --all, and name the URL.
    "remote": {
      "args": "check --unstable-tsc7 --allow-import remote/main.ts",
      "output": "[WILDCARD]Check remote/main.ts\n"
    },
    "remote_all": {
      "args": "check --unstable-tsc7 --allow-import --all remote/main.ts",
      "output": "remote_all.out",
      "exitCode": 1
    },
    "jsr": {
      "args": "check --unstable-tsc7 --allow-import jsr/main.ts",
      "output": "jsr.out",
      "exitCode": 1
    },
    // Import map aliases for a JSR package, a local directory and a URL.
    "import_map": {
      "cwd": "import_map",
      "args": "check --unstable-tsc7 --allow-import main.ts",
      "output": "import_map.out",
      "exitCode": 1
    },
    // `/// <reference lib="ende.*" />` keeps working: TS 7 only knows its
    // own lib names.
    "reference_lib": {
      "cwd": "reference_lib",
      "args": "check --unstable-tsc7 with_reference.ts",
      "output": "Check with_reference.ts\n"
    },
    "reference_lib_missing": {
      "cwd": "reference_lib",
      "args": "check --unstable-tsc7 without_reference.ts",
      "output": "reference_lib_missing.out",
      "exitCode": 1
    },
    // tsc crashes on files without an extension (denoland/deno#36173), so
    // the mirror adds one.
    "extensionless_import": {
      "args": "check --unstable-tsc7 --allow-import extensionless/main.ts",
      "output": "extensionless_import.out",
      "exitCode": 1
    },
    "extensionless_root": {
      "args": "check --unstable-tsc7 --allow-import --all http://localhost:4545/subdir/type_error_no_ext",
      "output": "extensionless_root.out",
      "exitCode": 1
    },
    // TS 7 removed `baseUrl`: it's left out with a warning, and Ende's
    // resolver still applies it to `paths`.
    "base_url": {
      "cwd": "base_url",
      "args": "check --unstable-tsc7 main.ts",
      "output": "base_url.out",
      "exitCode": 1
    },
    // TypeScript 7's stock lib.dom.d.ts and lib.webworker.d.ts lack Ende's
    // additions ("brotli", ReadableStream.from, Error.captureStackTrace), so
    // Ende replaces them, however the lib is named.
    "lib_additions_dom": {
      "cwd": "lib_additions",
      "args": "check --unstable-tsc7 --config dom.json dom.ts",
      "output": "lib_additions_dom.out",
      "exitCode": 1
    },
    "lib_additions_webworker": {
      "cwd": "lib_additions",
      "args": "check --unstable-tsc7 --config webworker.json webworker.ts",
      "output": "lib_additions_webworker.out",
      "exitCode": 1
    },
    "lib_additions_reference": {
      "cwd": "lib_additions",
      "args": "check --unstable-tsc7 reference.ts",
      "output": "lib_additions_reference.out",
      "exitCode": 1
    },
    // tsc resolves the imports of a file it reads in place itself, so a file
    // with an import Ende resolves its own way is copied, its specifiers
    // rewritten.
    "redirects_ts_types": {
      "cwd": "redirects",
      "args": "check --unstable-tsc7 ts_types.ts",
      "output": "redirects_ts_types.out",
      "exitCode": 1
    },
    "redirects_deno_types": {
      "cwd": "redirects",
      "args": "check --unstable-tsc7 deno_types.ts",
      "output": "redirects_deno_types.out",
      "exitCode": 1
    },
    // A relative import of an extensionless file, which is copied, and whose
    // import has X-TypeScript-Types.
    "redirects_extensionless": {
      "cwd": "redirects",
      "args": "check --unstable-tsc7 --allow-import extensionless.ts",
      "output": "redirects_extensionless.out",
      "exitCode": 1
    },
    // @deno-types overrules X-TypeScript-Types for its own import only.
    "redirects_remote_types": {
      "cwd": "redirects",
      "args": "check --unstable-tsc7 --allow-import remote_types.ts",
      "output": "redirects_remote_types.out",
      "exitCode": 1
    },
    "redirect_paths": {
      "cwd": "redirect_paths",
      "args": "check --unstable-tsc7 main.ts",
      "output": "redirect_paths.out",
      "exitCode": 1
    },
    // Import map scopes: one specifier, two modules.
    "scopes": {
      "cwd": "scopes",
      "args": "check --unstable-tsc7 main.ts",
      "output": "scopes.out",
      "exitCode": 1
    },
    // Related information and exact underlines, from `--pretty true`.
    "pretty": {
      "cwd": "pretty",
      "args": "check --unstable-tsc7 main.ts",
      "output": "pretty.out",
      "exitCode": 1
    },
    // Like TS 6, a check that passed isn't run again until something
    // changes; the two checkers' results are kept apart.
    "cache": {
      "tempDir": true,
      "steps": [{
        "cwd": "cache",
        "args": "check main.ts",
        "output": "Check main.ts\n"
      }, {
        "cwd": "cache",
        "args": "check --unstable-tsc7 main.ts",
        "output": "Check main.ts\n"
      }, {
        "cwd": "cache",
        "args": "check --unstable-tsc7 main.ts",
        "output": ""
      }, {
        "cwd": "cache",
        "args": [
          "eval",
          "Ende.writeTextFileSync('main.ts', 'export const label: string = 1;\\n')"
        ],
        "output": ""
      }, {
        "cwd": "cache",
        "args": "check --unstable-tsc7 main.ts",
        "output": "cache_error.out",
        "exitCode": 1
      }]
    },
    // Every subcommand that type-checks uses TypeScript 7 with the flag. Its
    // baseUrl warning shows it (TS 6 reports TS5101 instead).
    "subcommands_run": {
      "cwd": "subcommands",
      "args": "run --check --unstable-tsc7 main.ts",
      "output": "subcommands_run.out"
    },
    "subcommands_test": {
      "cwd": "subcommands",
      "args": "test --unstable-tsc7 main_test.ts",
      "output": "subcommands_test.out"
    },
    "subcommands_test_error": {
      "cwd": "subcommands",
      "args": "test --unstable-tsc7 error_test.ts",
      "output": "subcommands_test_error.out",
      "exitCode": 1
    },
    "subcommands_bench": {
      "cwd": "subcommands",
      "args": "bench --unstable-tsc7 main_bench.ts",
      "output": "subcommands_bench.out"
    },
    // The generated project lives in Ende's cache, not next to the code.
    "no_project_files": {
      "tempDir": true,
      "steps": [{
        "cwd": "no_project_files",
        "args": "check --unstable-tsc7 --allow-import main.ts",
        "output": "[WILDCARD]Check main.ts\n"
      }, {
        "cwd": "no_project_files",
        "args": [
          "eval",
          "console.log([...Ende.readDirSync('.')].map((e) => e.name))"
        ],
        "output": "[ \"main.ts\" ]\n"
      }]
    },
    // Copies of modules that left the graph are removed by the next check.
    "prune": {
      "tempDir": true,
      "steps": [{
        "cwd": "prune",
        "args": "check --unstable-tsc7 with_copy.ts",
        "output": "Check with_copy.ts\n"
      }, {
        "cwd": "prune",
        "args": "run --allow-env --allow-read list_copies.ts",
        "output": "[ \"remote/data/[WILDLINE].ts\" ]\n"
      }, {
        "cwd": "prune",
        "args": "check --unstable-tsc7 without_copy.ts",
        "output": "Check without_copy.ts\n"
      }, {
        "cwd": "prune",
        "args": "run --allow-env --allow-read list_copies.ts",
        "output": "[]\n"
      }]
    }
  }
}
