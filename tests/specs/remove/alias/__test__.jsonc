      "steps": [{
        "args": "remove my-alias@jsr:@endetest/add",
        "output": "[WILDCARD]"
      }, {
        "args": [
          "eval",
          "console.log(Deno.readTextFileSync('ende.json').trim())"
        ],
        "output": "ende.json.out"
      }]
    },
    "alias": {
      "steps": [{
        "args": "remove my-alias",
        "output": "[WILDCARD]"
      }, {
        "args": [
          "eval",
          "console.log(Deno.readTextFileSync('ende.json').trim())"
        ],
        "output": "ende.json.out"
      }]
    }
  }
}
