{
  "tempDir": true,
  "steps": [{
    "if": "unix",
    "args": "compile --unstable-fs --allow-read=data --include data --output main main.js",
    "output": "[WILDCARD]"
  }, {
    "if": "unix",
    "commandName": "./main",
    "args": [],
    "output": "output.out",
    "exitCode": 0
  }, {
    "if": "windows",
    "args": "compile --unstable-fs --allow-read=data --include data --output main.exe main.js",
    "output": "[WILDCARD]"
  }, {
    "if": "windows",
    "commandName": "./main.exe",
    "args": [],
    "output": "output.out",
    "exitCode": 0
  }]
}
