{
  "tests": {
    "subcommand": {
      "args": "bundle main.ts",
      "output": "subcommand.out",
      "exitCode": 1
    },
    "compile_bundle_flag": {
      "args": "compile --bundle main.ts",
      "output": "compile_bundle_flag.out",
      "exitCode": 1
    },
    "runtime_api": {
      "args": "run main.ts",
      "output": "runtime_api.out"
    }
  }
}
