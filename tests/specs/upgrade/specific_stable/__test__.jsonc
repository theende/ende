{
  "if": "notWindowsArm",
  "tempDir": true,
  "steps": [
    {
      "args": "eval Deno.copyFileSync(Deno.execPath(),'./deno_copy');",
      "exitCode": 0,
      "output": ""
    },
    {
      "commandName": "./deno_copy",
      "args": "upgrade --force --version 2026.10.14",
      "output": "upgrade.out",
      "exitCode": 0,
      "flaky": true
    },
    {
      "commandName": "./deno_copy",
      "args": "--version",
      "exitCode": 0,
      "output": "version.out"
    }
  ]
}
