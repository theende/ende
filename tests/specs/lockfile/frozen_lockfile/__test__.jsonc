{
  "tempDir": true,
  "tests": {
    "error_with_new_jsr_dep": {
      "steps": [
        {
          "args": "cache jsr.ts",
          "output": "[WILDCARD]"
        },
        {
          "args": "run --frozen jsr2.ts",
          "output": "frozen_new_dep_jsr_run.out",
          "exitCode": 1
        },
        {
          "args": "cache --frozen jsr2.ts",
          "output": "frozen_new_dep_jsr_cache.out",
          "exitCode": 1
        },
        {
          // update the lockfile
          "args": "cache jsr2.ts",
          "output": ""
        },
        {
          "args": "run --frozen jsr2.ts",
          "output": "1 + 2 = 3\n"
        }
      ]
    },
    "no_error_when_in_lockfile": {
      "steps": [
        {
          "args": "cache add.ts",
          "output": "[WILDCARD]"
        },
        {
          "args": "run --frozen add.ts",
          "output": "1 + 2 = 3\n"
        }
      ]
    },
    "errors_if_creates_lockfile": {
      "steps": [
        {
          "args": [
            "eval",
            "Deno.statSync('lock.json')"
          ],
          "output": "[WILDCARD]NotFound[WILDCARD]",
          "exitCode": 1
        },
        {
          "args": "run --frozen add.ts",
          "output": "no_lockfile_run.out",
          "exitCode": 1
        }
      ]
    },
    "lockfile_config": {
      "steps": [
        {
          "args": [
            "eval",
            "Deno.writeTextFileSync('ende.json', JSON.stringify({ lock: { frozen: true }, ...JSON.parse(Deno.readTextFileSync('ende.json')) }))"
          ],
          "output": ""
        },
        {
          "args": "cache --frozen=false add.ts",
          "output": "[WILDCARD]"
        },
        {
          // jsr.ts imports a jsr package version that's not in the lockfile
          "args": "run jsr.ts",
          "output": "[WILDCARD]The lockfile is out of date[WILDCARD]",
          "exitCode": 1
        },
        {
          "args": "cache jsr.ts",
          "output": "[WILDCARD]The lockfile is out of date[WILDCARD]",
          "exitCode": 1
        }
      ]
    },
    "non_analyzable_dynamic_jsr": {
      "steps": [
        {
          "args": "cache add.ts",
          "output": "[WILDCARD]"
        },
        {
          "args": "run --frozen --allow-net jsr-dynamic.ts",
          "output": "frozen_new_dep_dynamic_jsr.out",
          "exitCode": 1
        }
      ]
    },
    "non_analyzable_dynamic_http": {
      "steps": [
        {
          "args": "cache add.ts",
          "output": "[WILDCARD]"
        },
        {
          "args": "run --frozen --allow-import http-dynamic.ts",
          "output": "frozen_new_dep_dynamic_http.out",
          "exitCode": 1
        }
      ]
    },
    "check_subcommand": {
      "steps": [
        {
          "args": "check --frozen=true add.ts",
          "output": "[WILDCARD]The lockfile is out of date[WILDCARD]",
          "exitCode": 1
        },
        {
          // the previous step already type checked add.ts before failing on
          // the lockfile, so this run may be a type check cache hit
          "args": "check --frozen=false add.ts",
          "output": "[WILDCARD]"
        }
      ]
    }
  }
}
