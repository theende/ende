{
  "tempDir": true,
  "steps": [
    {
      "args": "add --lockfile-only jsr:@endetest/add",
      "output": "install.out"
    },
    {
      // Verify node_modules was not created. Also that the lockfile was created and contains the package
      "args": [
        "eval",
        "try { Deno.statSync('node_modules') } catch { console.log(true) } const lock = JSON.parse(Deno.readTextFileSync('ende.lock')); console.log(Object.keys(lock.jsr).includes('@endetest/add@1.0.0'))"
      ],
      "output": "true\ntrue\n"
    },
    // now test remove
    {
      "args": "remove --lockfile-only jsr:@endetest/add",
      "output": "remove.out"
    },
    {
      // Verify node_modules was not created. Also that the lockfile does not contain the jsr package anymore
      "args": [
        "eval",
        "try { Deno.statSync('node_modules') } catch { console.log(true) } const lock = JSON.parse(Deno.readTextFileSync('ende.lock')); console.log(lock.jsr == null)"
      ],
      "output": "true\ntrue\n"
    }
  ]
}
