{
  "tempDir": true,
  "tests": {
    // `add` without a config creates ende.json (and ende.lock).
    "creates_ende_json": {
      "steps": [{
        "args": "add jsr:@denotest/add",
        "output": "Created ende.json configuration file.\n[WILDCARD]"
      }, {
        "args": "run --no-config --no-lock -R check.ts",
        "output": "ende.json: true (has dep)\ndeno.json: false\nende.lock: true\ndeno.lock: false\n"
      }]
    },
    // `add` edits an existing deno.json in place instead of creating
    // ende.json.
    "edits_existing_deno_json": {
      "steps": [{
        "cwd": "existing_deno_json",
        "args": "add jsr:@denotest/add",
        "output": "Warning: \"deno.json\" in [WILDLINE] is deprecated. Rename it to \"ende.json\".\n[WILDCARD]"
      }, {
        "cwd": "existing_deno_json",
        "args": "run --no-config --no-lock -R ../check.ts",
        "output": "ende.json: false\ndeno.json: true (has dep)\nende.lock: true\ndeno.lock: false\n"
      }]
    }
  }
}
