{
  "tests": {
    "ende": {
      "args": "bundle --platform=ende main.ts",
      "output": "ende.out"
    },
    // The deprecated `deno` platform name is still accepted, with a warning.
    "deno_deprecated": {
      "args": "bundle --platform=deno main.ts",
      "output": "deno_deprecated.out"
    },
    "api_deno_deprecated": {
      "args": "run -A --unstable-bundle api.ts",
      "output": "api_deno_deprecated.out"
    }
  }
}
